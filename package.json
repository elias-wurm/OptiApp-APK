{
  "name": "optik-falkner-app",
  "version": "1.13.0",
  "private": true,
  "description": "Kunden-App „Mein Optiker“ (OptiApp, Glas-Look) – Prototyp mit Demo-Daten",
  "scripts": {
    "android:add": "cap add android",
    "android:icons": "capacitor-assets generate --android --iconBackgroundColor \"#F0643C\" --iconBackgroundColorDark \"#F0643C\" --splashBackgroundColor \"#ECEFF3\" --splashBackgroundColorDark \"#12151B\"",
    "android:sync": "cap sync android",
    "android:build": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "7.6.9"
  }
}
